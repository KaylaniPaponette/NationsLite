<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <UIContainer class="menu-container">
        <UILabel text="Attractions" class="menu-title" /> <!-- Just capitalized the A for attractions -->
        <UILabel text="Select an item to start building the attraction" class="menu-subtitle" />
        <UIContainer is-scroll-target="true" name="itemsContainer" scroll-direction="Horizontal" class="items-container" />
    </UIContainer>
</engine:UXML>
