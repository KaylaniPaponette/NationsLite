.menu-container {
    width: 75%;
    max-width: 75%;
    background-color: rgba(0, 0, 0, 0.8);
    border-color: rgba(0, 0, 0, 0.7);
    border-width: 1px;
    border-radius: 10px;
    align-self: center;
    align-content: auto;
    justify-content: flex-start;
    align-items: center;
    position: absolute;
    top: 50%;
    transform: translate(0, -50%);
    padding: 24px;
    color: rgb(255, 255, 255);
}

.menu-title {
    font-size: 56px;
    /* -unity-font: resource("Assets/Data/Fonts/TT_Norms_Pro_Serif_Trial_Normal.ttf"); */
}

.menu-subtitle {
    font-size: 36px;
    /* -unity-font: resource("Assets/Data/Fonts/TT_Norms_Pro_Serif_Trial_Normal.ttf"); */
}

.tab-container
{
    flex-direction: row;
    width: 100%;
    background-color: rgba(60, 60, 60, 0.8);
    border-radius: 6px;
    margin-top: 16px;
}

.tab-button
{
    flex: 1;
    padding: 12px;
    background-color: rgba(80, 80, 80, 0.8);
    color: white;
    font-size: 28px;
    align-items: center;
    justify-content: center;
    border-width: 0;
    border-radius: 5px;
    margin: 0;
}

.tab-button:hover
{
    background-color: rgba(100, 100, 100, 0.8);
}

.tab-button .ui-toggle__checkmark
{
    display: none;
}

.tab-button.active
{
    background-color: rgba(0, 0, 0, 0.8);
    border-bottom-width: 3px;
    border-bottom-color: rgb(255, 0, 0);
}

.items-container {
    width: 100%;
    flex-direction: row;
    flex-grow: 0;
    margin: 16px 0px 16px 0px;
}

/* Main item card */
.item-card {
    min-width: 375px;
    max-height: 320px;
    background-color: rgba(48, 48, 48, 0.8);
    border-color: rgba(0, 0, 0, 0.5);
    border-width: 1px;
    border-radius: 8px;
    -unity-text-align: upper-center;
    align-items: center;
    padding: 20px;
    margin: 0px 0px 0px 20px;
    flex-direction: column;
    overflow: visible;
    color: rgb(255, 255, 255);
    /* -unity-font: resource("Assets/Data/Fonts/TT_Norms_Pro_Serif_Trial_Normal.ttf"); */
    justify-content: space-evenly;
}

.item-card:hover {
    background-color: rgba(84, 84, 84, 0.8);
}

.item-card:disabled {
    background-color: rgba(111, 111, 111, 0.8);
}

.attraction-thumbnail {
    width: 128px;
    height: 128px;
    margin: 0px 0px 16px 0px;
    padding: 0;
}

.attraction-title {
    font-size: 28px;
    min-height: 64px;
    justify-content: space-evenly;
}

.attraction-description {
    font-size: 28px;
    min-height: 24px;
}

.reward-container {
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.reward-container UILabel,
.reward-container UIContainer {
    font-size: 24;
    padding-right: 4px;
}

.currency-container {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: auto;
    font-size: auto;
}

.currency-label-container {
    flex-direction: row;
}

.currency-cost, .currency-text {
    align-items: center;
    justify-content: center;
    font-size: 28px;
}

.currency-icon {
    width: 48px;
    height: 48px;
}

.powwow-cost {
    color: #2A9D8F;
}

.prestige-cost {
    color: #E9C46A;
}